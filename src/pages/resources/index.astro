---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { RESOURCE_TRACKS } from '../../consts';
import { getResources, inTrack } from '../../utils/resources';

const resources = await getResources();
const tracks = RESOURCE_TRACKS.map((track) => ({
  ...track,
  count: inTrack(resources, track.slug).length,
}));
---

<BaseLayout
  title="Resources"
  description="Structured technical study material: system design today, machine coding next."
>
  <PageHeader
    eyebrow="Resources"
    title="Study material, organised."
    intro="Pick a track and work through it topic by topic. Looking for essays on management instead? Read the blog."
  />

  <div class="grid gap-4 md:grid-cols-2">
    {
      tracks.map((track) => (
        <a
          href={`/resources/${track.slug}`}
          class={`tile ${track.accent} group block`}
          data-reveal
        >
          <p class="eyebrow">
            {!track.comingSoon && track.count ? `${track.count} ${track.count === 1 ? 'article' : 'articles'}` : 'Coming soon'}
          </p>
          <h2 class="font-display mt-2 text-4xl leading-tight font-medium tracking-tight group-hover:italic">
            {track.title}
          </h2>
          <p class="mt-3 text-sm">{track.blurb}</p>
        </a>
      ))
    }
  </div>

  <p class="mt-14">
    <a href="/blog" class="btn-ghost">Read the blog →</a>
  </p>
</BaseLayout>
