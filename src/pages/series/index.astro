---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPosts, groupBySeries, slugify, accentFor } from '../../utils/posts';

const series = [...groupBySeries(await getPosts()).entries()];
---

<BaseLayout title="Series" description="Multi-part guides on engineering management.">
  <PageHeader
    eyebrow="Learning paths"
    title="Series"
    intro="Multi-part guides meant to be read in order."
  />
  <div class="grid gap-4 md:grid-cols-2">
    {
      series.map(([name, posts], i) => (
        <a
          href={`/series/${slugify(name)}`}
          data-reveal
          style={`--d: ${i * 80}ms`}
          class={`tile ${accentFor(name)} flex min-h-64 flex-col justify-between`}
        >
          <span class="eyebrow">{posts.length} parts</span>
          <h2 class="font-display text-4xl leading-tight font-medium tracking-tight">{name}</h2>
        </a>
      ))
    }
  </div>
</BaseLayout>
