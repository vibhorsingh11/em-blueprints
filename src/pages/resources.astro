---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../utils/posts';

const posts = await getPosts();

// One job for this page: "where are you right now?" Each stage is a reading order, not an archive.
const stages = [
  {
    level: 'aspiring',
    title: 'Thinking about management',
    blurb: 'Is this the right move, and what will actually change?',
    accent: 'bg-sage',
  },
  {
    level: 'new-em',
    title: 'Just became a manager',
    blurb: 'Your first months: 1:1s, feedback, and finding your rhythm.',
    accent: 'bg-butter',
  },
  {
    level: 'experienced',
    title: 'Levelling up',
    blurb: 'Scaling teams, hard conversations, and leading leaders.',
    accent: 'bg-lilac',
  },
] as const;

const byStage = stages.map((stage) => ({
  ...stage,
  posts: posts
    .filter((p) => p.data.level === stage.level)
    .sort(
      (a, b) =>
        (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0) ||
        a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
    ),
}));
---

<BaseLayout
  title="Resources"
  description="Curated reading paths for engineers becoming engineering managers, by career stage."
>
  <PageHeader
    eyebrow="Resources"
    title="Where are you on the path?"
    intro="Pick your stage and read top to bottom. Looking for everything instead? Browse the blog."
  />

  <div class="space-y-6">
    {
      byStage.map((stage, i) => (
        <section class="grid gap-4 lg:grid-cols-[19rem_1fr]" data-reveal>
          <div class={`tile ${stage.accent} self-start lg:sticky lg:top-28`}>
            <p class="eyebrow">Stage {String(i + 1).padStart(2, '0')}</p>
            <h2 class="font-display mt-2 text-3xl leading-tight font-medium tracking-tight">
              {stage.title}
            </h2>
            <p class="mt-3 text-sm">{stage.blurb}</p>
          </div>
          <div class="border-ink/15 border-t">
            {stage.posts.length ? (
              stage.posts.map((post, n) => <PostCard {post} index={n} />)
            ) : (
              <p class="text-muted py-7">Posts for this stage are coming soon.</p>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <p class="mt-14">
    <a href="/blog" class="btn-ghost">Browse the blog →</a>
  </p>
</BaseLayout>
