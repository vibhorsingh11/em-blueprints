---
import BaseLayout from '../layouts/BaseLayout.astro';
import Orb from '../components/Orb.astro';
---

<BaseLayout title="Page not found">
  <section class="grid items-center gap-8 md:grid-cols-2">
    <div>
      <p class="eyebrow text-clay">404</p>
      <h1 class="font-display mt-3 text-6xl leading-none font-medium tracking-tight sm:text-8xl">
        Lost? <em class="text-clay font-normal">Breathe.</em>
      </h1>
      <p class="text-muted mt-5 text-lg">That page doesn't exist. Nothing is on fire.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/blog" class="btn">Read the blog →</a>
        <a href="/resources" class="btn-ghost">Browse resources</a>
      </div>
    </div>
    <Orb />
  </section>
</BaseLayout>
