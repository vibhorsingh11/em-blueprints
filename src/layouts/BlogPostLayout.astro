---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import SeriesNav from '../components/SeriesNav.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import AuthorBio from '../components/AuthorBio.astro';
import type { MarkdownHeading } from 'astro';
import { accentFor, type Post } from '../utils/posts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  minutes: number;
  seriesPosts: Post[];
  related: Post[];
}
const { post, headings, minutes, seriesPosts, related } = Astro.props;
const { title, description, pubDate, updatedDate, series } = post.data;
---

<BaseLayout {title} {description} type="article" {pubDate} {updatedDate}>
  <ReadingProgress />

  <header class="mx-auto max-w-4xl pt-6 pb-12 text-center" data-reveal>
    {
      series && (
        <a
          href={`/series/${series.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class={`eyebrow ${accentFor(series)} border-ink/15 inline-block rounded-full border px-4 py-1.5`}
        >
          {series}
        </a>
      )
    }
    <h1
      class="font-display mt-6 text-[clamp(2.5rem,7vw,5.5rem)] leading-[1] font-medium tracking-tight"
    >
      {title}
    </h1>
    <p class="text-muted mx-auto mt-6 max-w-2xl text-xl">{description}</p>
    <p class="eyebrow text-muted mt-8 flex flex-wrap justify-center gap-x-4 gap-y-1">
      <FormattedDate date={pubDate} />
      <span>{minutes} min read</span>
      {
        updatedDate && (
          <span>
            Updated <FormattedDate date={updatedDate} />
          </span>
        )
      }
    </p>
  </header>

  <div class="mx-auto max-w-5xl lg:grid lg:grid-cols-[1fr_13rem] lg:gap-14">
    <article class="min-w-0">
      <div class="prose prose-lg prose-mindful max-w-[42rem]">
        <slot />
      </div>

      <div class="max-w-[42rem]">
        {series && <SeriesNav {series} posts={seriesPosts} currentId={post.id} />}
        <div class="my-10"><NewsletterForm /></div>
        <AuthorBio />
        <RelatedPosts posts={related} />
      </div>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-28"><TableOfContents {headings} /></div>
    </aside>
  </div>
</BaseLayout>
