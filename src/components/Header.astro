---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
---

<header class="fixed inset-x-0 top-4 z-50 px-4">
  <nav
    aria-label="Main"
    class="bg-paper/92 border-ink/15 mx-auto flex max-w-3xl items-center justify-between gap-2 rounded-full border py-2 pr-2 pl-5 shadow-sm backdrop-blur-xl"
  >
    <a href="/" class="flex items-center gap-2.5">
      <span class="bg-clay orb block size-3 rounded-full" aria-hidden="true"></span>
      <span class="font-display text-lg font-medium tracking-tight">{SITE_TITLE}</span>
    </a>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 text-sm md:flex">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.match.some((m) => path.startsWith(m)) ? 'page' : undefined}
                class="hover:bg-ink/10 aria-[current=page]:bg-ink aria-[current=page]:text-paper rounded-full px-3.5 py-1.5 transition"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
      <details class="group relative md:hidden">
        <summary
          class="hover:bg-ink/10 flex size-9 cursor-pointer list-none items-center justify-center rounded-full"
          aria-label="Menu"
        >
          <span class="text-lg group-open:hidden" aria-hidden="true">☰</span>
          <span class="hidden text-lg group-open:inline" aria-hidden="true">✕</span>
        </summary>
        <ul
          class="bg-paper border-ink/15 absolute top-12 right-0 w-48 rounded-3xl border p-2 shadow-xl"
        >
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="hover:bg-ink/10 block rounded-2xl px-4 py-2.5">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>
