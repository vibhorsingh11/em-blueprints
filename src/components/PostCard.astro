---
import type { Post } from '../utils/posts';
import { accentFor } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: Post;
  index?: number;
}
const { post, index } = Astro.props;
---

<a
  href={`/blog/${post.id}`}
  data-reveal
  class="group border-ink/15 grid grid-cols-[auto_1fr_auto] items-center gap-x-5 gap-y-1 border-b py-7 transition hover:px-3 sm:gap-x-8"
>
  <span class="eyebrow text-muted self-start pt-2">
    {index !== undefined ? String(index + 1).padStart(2, '0') : '—'}
  </span>
  <div>
    <h3
      class="font-display text-2xl leading-tight font-medium tracking-tight sm:text-4xl group-hover:italic"
    >
      {post.data.title}
    </h3>
    <p class="text-muted mt-2 max-w-2xl">{post.data.description}</p>
    <p class="eyebrow text-muted mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
      {
        post.data.series && (
          <span class={`${accentFor(post.data.series)} text-ink rounded-full px-2.5 py-0.5`}>
            {post.data.series}
          </span>
        )
      }
      <FormattedDate date={post.data.pubDate} />
    </p>
  </div>
  <span
    class="border-ink/30 group-hover:bg-clay group-hover:border-clay grid size-12 place-items-center rounded-full border text-xl transition group-hover:-rotate-45"
    aria-hidden="true">→</span
  >
</a>
