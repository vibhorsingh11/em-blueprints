---
const topics = [
  '1:1s',
  'Feedback',
  'Delegation',
  'Hiring',
  'Promotions',
  'Burnout',
  'Roadmaps',
  'Conflict',
  'Career ladders',
  'Calm',
];
---

<div
  class="marquee bg-ink text-paper relative left-1/2 my-14 w-[104vw] -translate-x-1/2 -rotate-1 overflow-hidden py-4"
  aria-hidden="true"
>
  <div class="marquee-track font-display flex w-max gap-10 text-3xl whitespace-nowrap italic">
    {
      [0, 1].map(() =>
        topics.map((t) => (
          <span class="flex items-center gap-10">
            {t} <span class="text-clay not-italic">✺</span>
          </span>
        )),
      )
    }
  </div>
</div>
